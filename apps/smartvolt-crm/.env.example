# Server-only. Use a dedicated SmartVolt Supabase project, never another app's credentials.
SMARTVOLT_SUPABASE_URL=
SMARTVOLT_SUPABASE_PUBLISHABLE_KEY=
SMARTVOLT_SUPABASE_SECRET_KEY=
SMARTVOLT_APP_URL=
# Server-only AES-256-GCM master key: 32 random bytes encoded as canonical base64.
# Separate production/non-production values; never replace without re-encrypting saved connections.
SMARTVOLT_WHATSAPP_ENCRYPTION_KEY=
# Optional reviewed Graph version. Adapter defaults to v27.0.
SMARTVOLT_WHATSAPP_GRAPH_VERSION=
# Real model execution is not enabled in this delivery. See system cards.
